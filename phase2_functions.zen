// Zenith Test Case 3: Procedural Abstractions & Functions
// Phase 2 Deliverable: Activation Records, Call Frames & TAC Function Dispatch
// ============================================================================

// Function to compute absolute difference
fn abs_diff(a: int, b: int) -> int {
    if (a >= b) {
        return a - b;
    } else {
        return b - a;
    }
}

// Function to calculate volume of a cylinder: V = pi * r^2 * h
fn cylinder_volume(radius: float, height: float) -> float {
    const PI: float = 3.14159265;
    let r_sq: float = radius * radius;
    let vol: float = PI * r_sq * height;
    return vol;
}

// Function with iterative power computation
fn power(base: int, exp: int) -> int {
    let result: int = 1;
    for (let i: int = 0; i < exp; i = i + 1) {
        result = result * base;
    }
    return result;
}

// Invocations
let diff: int = abs_diff(42, 95);
let volume: float = cylinder_volume(3.0, 10.0);
let pow_val: int = power(2, 8);

print("--- Procedural Function Invocations ---");
print("Absolute Difference |42 - 95|:", diff);
print("Cylinder Volume (r=3, h=10):", volume);
print("Power of 2^8:", pow_val);
