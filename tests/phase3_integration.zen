// Check if a number is prime
fn is_prime(n: int) -> bool {
    if (n < 2) {
        return false;
    }
    if (n == 2) {
        return true;
    }
    let i: int = 2;
    while (i * i <= n) {
        if ((n % i) == 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Count prime numbers up to limit using Sieve-like iteration
fn count_primes(limit: int) -> int {
    let count: int = 0;
    for (let k: int = 2; k <= limit; k = k + 1) {
        if (is_prime(k)) {
            count = count + 1;
        }
    }
    return count;
}

// Convert Celsius to Fahrenheit: F = (C * 9 / 5) + 32
fn celsius_to_fahrenheit(celsius: float) -> float {
    return celsius * 9.0 / 5.0 + 32.0;
}

// Compute nth triangular number: T(n) = n*(n+1)/2
fn triangular(n: int) -> int {
    return n * (n + 1) / 2;
}

// Compute integer square root (floor) using Newton's method iterations
fn int_sqrt(n: int) -> int {
    if (n < 0) {
        return 0;
    }
    if (n == 0) {
        return 0;
    }
    let guess: int = n / 2 + 1;
    for (let iter: int = 0; iter < 20; iter = iter + 1) {
        let next_g: int = (guess + n / guess) / 2;
        if (next_g >= guess) {
            return guess;
        }
        guess = next_g;
    }
    return guess;
}

// Compute GCD
fn gcd(a: int, b: int) -> int {
    let x: int = a;
    let y: int = b;
    while (y != 0) {
        let t: int = y;
        y = x % y;
        x = t;
    }
    return x;
}

// Compute LCM
fn lcm(a: int, b: int) -> int {
    return a * b / gcd(a, b);
}

